{
	"name": "my-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:cf": "opennextjs-cloudflare build && wrangler dev --port 8787",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate:local": "wrangler d1 migrations apply ux42-portfolio-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply ux42-portfolio-db --remote",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:seed:local": "wrangler d1 execute ux42-portfolio-db --local --file=./drizzle/seed.sql",
		"db:seed:remote": "wrangler d1 execute ux42-portfolio-db --remote --file=./drizzle/seed.sql"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.17.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"next": "16.1.5",
		"react": "19.1.5",
		"react-dom": "19.1.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.35",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"tsx": "^4.23.5",
		"typescript": "^5.7.4",
		"wrangler": "^4.86.0"
	}
}