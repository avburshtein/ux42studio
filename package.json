{
	"name": "my-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:cf": "npm run build:cf && wrangler dev --port 8787",
		"build:cf": "node scripts/build-cloudflare.mjs build",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint src --ext .ts,.tsx",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "npm run typecheck && npm run lint",
		"smoke": "node scripts/smoke-test.mjs",
		"smoke:prod": "node scripts/smoke-test.mjs https://ux42.studio",
		"verify": "npm run check && node scripts/smoke-test.mjs",
		"deploy": "npm run build:cf && node scripts/build-cloudflare.mjs deploy",
		"upload": "npm run build:cf && node scripts/build-cloudflare.mjs upload",
		"preview": "npm run build:cf && node scripts/build-cloudflare.mjs preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate:local": "node scripts/apply-migrations.mjs --local",
		"db:migrate:remote": "node scripts/apply-migrations.mjs --remote",
		"db:migrate:local:only": "node scripts/apply-migrations.mjs --local --migrations-only",
		"db:migrate:remote:only": "node scripts/apply-migrations.mjs --remote --migrations-only",
		"db:seed:local": "node scripts/apply-migrations.mjs --local --seed-only",
		"db:seed:remote": "node scripts/apply-migrations.mjs --remote --seed-only",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.7.1",
		"@material/material-color-utilities": "^0.4.0",
		"@opennextjs/cloudflare": "^1.17.1",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"jose": "^6.2.8",
		"lucide-react": "^1.29.0",
		"next": "16.1.5",
		"react": "19.1.5",
		"react-dom": "19.1.5",
		"react-dropzone": "^19.3.0",
		"react-hook-form": "^7.84.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.35",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"tsx": "^4.23.5",
		"typescript": "^5.7.4",
		"wrangler": "^4.86.0"
	}
}
